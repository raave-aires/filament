<?xml version="1.0" encoding="utf-8"?>
<!--
  Só existe no build de debug: libera HTTP puro pro backend local de desenvolvimento.
  cleartext geral (não por domínio) porque API_BASE_URL varia por máquina/rede
  (10.0.2.2 no emulador, IP da LAN ou 127.0.0.1 via `adb reverse` em dispositivo físico —
  ver comentário de "api.baseUrl" em app/build.gradle.kts).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
