<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup até o Android 11 (o app é minSdk 33, mantido por completude). Ver data_extraction_rules.xml. -->
<full-backup-content>
    <!-- Bearer token da sessão (AuthTokenStore): restaurado em outro aparelho viraria uma sessão
         copiada sem novo login. -->
    <exclude domain="sharedpref" path="filament_auth_prefs.xml" />
</full-backup-content>
