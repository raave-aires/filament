<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. O token da sessão (AuthTokenStore, filament_auth_prefs.xml) nunca sai do aparelho:
     nem no backup na nuvem, nem na transferência pra um celular novo — lá o usuário faz login de novo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="filament_auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="filament_auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
